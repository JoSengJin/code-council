GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
JUDGE_PROVIDER=gemini
PAID_API_ENABLED=false
MOCK_PROVIDERS=false
PORT=3001
# Windows에서 Codex 실행 파일을 자동으로 찾지 못할 때만 절대 경로를 지정하세요.
# CODEX_BIN=C:\Users\name\AppData\Local\OpenAI\Codex\bin\<version>\codex.exe
# Codex 추론 강도(선택). 모델이 지원하는 값(예: low, medium, high)만 지정하세요. 비우면 기본값을 씁니다.
# CODEX_EFFORT=medium
